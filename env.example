# FESTIVE G - Environment Variables Template
# 
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Then load it:
#   export $(cat .env | xargs)
#   python app.py
#
# Or on Windows:
#   for /f "delims=" %i in (.env) do @set "%i"
#   python app.py

# ============================================================================
# ADMIN AUTHENTICATION (Required for Production)
# ============================================================================

# Admin panel password
# Default: "admin123" (MUST change for production!)
FESTIVE_G_ADMIN_PASSWORD=your_super_secure_password_here


# ============================================================================
# EMAIL CONFIGURATION (Optional)
# ============================================================================
# If not set, the app will still run but won't send emails.
# Greetings will be saved with email_status showing configuration error.

# SMTP Server (required to send emails)
# Examples:
#   Gmail: smtp.gmail.com
#   Outlook: smtp-mail.outlook.com
#   Office 365: smtp.office365.com
#   SendGrid: smtp.sendgrid.net
FESTIVE_G_SMTP_HOST=smtp.gmail.com

# SMTP Port (default: 587 for TLS, 465 for SSL)
FESTIVE_G_SMTP_PORT=587

# SMTP Username (usually your email address)
FESTIVE_G_SMTP_USER=your_email@gmail.com

# SMTP Password (use app-specific password for Gmail)
# For Gmail: https://myaccount.google.com/apppasswords
FESTIVE_G_SMTP_PASSWORD=your_16_character_app_password

# Email "From" address (optional, defaults to sender's email)
# Examples:
#   no-reply@festive-g.com
#   FESTIVE G <no-reply@example.com>
FESTIVE_G_EMAIL_FROM=no-reply@festive-g.com

# Use TLS for SMTP connection (default: true)
# Set to "false" to disable TLS
FESTIVE_G_SMTP_TLS=true


# ============================================================================
# EXAMPLES FOR COMMON EMAIL PROVIDERS
# ============================================================================

# --- Gmail (recommended) ---
# FESTIVE_G_SMTP_HOST=smtp.gmail.com
# FESTIVE_G_SMTP_PORT=587
# FESTIVE_G_SMTP_USER=your_email@gmail.com
# FESTIVE_G_SMTP_PASSWORD=your_16_char_app_password
# Note: Use App Passwords, not your account password
# Get it at: https://myaccount.google.com/apppasswords

# --- Outlook / Hotmail ---
# FESTIVE_G_SMTP_HOST=smtp-mail.outlook.com
# FESTIVE_G_SMTP_PORT=587
# FESTIVE_G_SMTP_USER=your_email@outlook.com
# FESTIVE_G_SMTP_PASSWORD=your_password

# --- Office 365 ---
# FESTIVE_G_SMTP_HOST=smtp.office365.com
# FESTIVE_G_SMTP_PORT=587
# FESTIVE_G_SMTP_USER=your_email@company.com
# FESTIVE_G_SMTP_PASSWORD=your_password

# --- SendGrid ---
# FESTIVE_G_SMTP_HOST=smtp.sendgrid.net
# FESTIVE_G_SMTP_PORT=587
# FESTIVE_G_SMTP_USER=apikey
# FESTIVE_G_SMTP_PASSWORD=SG.xxxxxxxxxxxx
# FESTIVE_G_EMAIL_FROM=noreply@yourdomain.com

# ============================================================================
# DEVELOPMENT SETTINGS
# ============================================================================

# Application host (default: 127.0.0.1 for localhost only)
# Change to 0.0.0.0 for production (use behind reverse proxy)
# APP_HOST=127.0.0.1

# Application port (default: 4173)
# APP_PORT=4173

# ============================================================================
# NOTES
# ============================================================================
# 
# - Never commit your .env file to Git (it's in .gitignore)
# - Keep passwords and secrets secure
# - Use strong, unique passwords for production
# - Regenerate SMTP credentials if exposed
# - For more info, see README.md
#
